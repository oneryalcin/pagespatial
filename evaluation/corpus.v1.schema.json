{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pagespatial.dev/schema/evaluation/corpus.v1.schema.json",
  "title": "PageSpatialCorpusV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "documents"],
  "properties": {
    "schemaVersion": { "const": "pagespatial-corpus-v1" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoType", "repoId", "revision"],
      "properties": {
        "repoType": { "const": "dataset" },
        "repoId": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectId", "path", "sha256", "pageCount", "split", "familyId", "selectionNotes", "pages"],
        "properties": {
          "objectId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+\\.[Pp][Dd][Ff]$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "pageCount": { "type": "integer", "minimum": 1 },
          "split": { "enum": ["development", "holdout"] },
          "familyId": { "type": "string", "minLength": 1 },
          "selectionNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pageNumber", "labels"],
              "properties": {
                "pageNumber": { "type": "integer", "minimum": 1 },
                "labels": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "native-text", "image-only", "mixed-raster-native", "dense-table", "chart",
                      "multi-column", "form", "multilingual", "slides", "long-document", "landscape",
                      "sparse-overlay", "translation-sibling", "packet-sibling", "version-sibling"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
