{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enrichmentSchemaVersion": {
      "type": "string",
      "const": "enrichment-0.2.0"
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "revisionId": {
      "type": "string",
      "minLength": 1
    },
    "documentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pageId": {
      "type": "string",
      "minLength": 1
    },
    "pageNumber": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "basePageDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "object",
      "properties": {
        "blockingReasons": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "blockingReasons"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "transcription": {
          "type": "object",
          "properties": {
            "adapter": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "mediaResolution": {
              "type": "string",
              "minLength": 1
            },
            "promptRevision": {
              "type": "string",
              "minLength": 1
            },
            "thinkingBudget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "transport": {
              "type": "string",
              "enum": [
                "interactive",
                "batch"
              ]
            }
          },
          "required": [
            "adapter",
            "model",
            "mediaResolution",
            "promptRevision",
            "thinkingBudget"
          ],
          "additionalProperties": false
        },
        "adjudication": {
          "type": "object",
          "properties": {
            "adapter": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "mediaResolution": {
              "type": "string",
              "minLength": 1
            },
            "promptRevision": {
              "type": "string",
              "minLength": 1
            },
            "thinkingBudget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "transport": {
              "type": "string",
              "enum": [
                "interactive",
                "batch"
              ]
            }
          },
          "required": [
            "adapter",
            "model",
            "mediaResolution",
            "promptRevision",
            "thinkingBudget"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "modelBoxHint": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 4,
            "maxItems": 4,
            "items": false
          },
          "corroboration": {
            "type": "string",
            "enum": [
              "corroborated-both",
              "corroborated-native",
              "corroborated-ocr",
              "novel"
            ]
          }
        },
        "required": [
          "text",
          "corroboration"
        ],
        "additionalProperties": false
      }
    },
    "adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conflictId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "native",
              "ocr",
              "both-wrong",
              "unsure"
            ]
          },
          "unanswered": {
            "type": "boolean",
            "const": true
          },
          "inkText": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "conflictId",
          "verdict"
        ],
        "additionalProperties": false
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "promptTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "promptTokens",
        "outputTokens",
        "latencyMs"
      ],
      "additionalProperties": false
    },
    "trust": {
      "type": "string",
      "const": "untrusted-document-content"
    }
  },
  "required": [
    "enrichmentSchemaVersion",
    "documentId",
    "revisionId",
    "documentSha256",
    "pageId",
    "pageNumber",
    "basePageDigest",
    "createdAt",
    "trigger",
    "provenance",
    "proposals",
    "adjudications",
    "telemetry",
    "trust"
  ],
  "additionalProperties": false,
  "$id": "https://pagespatial.dev/schema/0.1.0/pagespatial-enrichment.schema.json",
  "title": "EscalatedOcrEnrichment"
}
