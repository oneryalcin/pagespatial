# Copy to deploy/control-plane/.env. Never commit the populated file.

# Public routing. Configure both Tunnel hostnames to http://api:8580.
PAGESPATIAL_API_HOST=api.pagespatial.dev
PAGESPATIAL_APP_HOST=app.pagespatial.dev
TUNNEL_TOKEN=

# Cloudflare Access application protecting only PAGESPATIAL_APP_HOST.
CLOUDFLARE_ACCESS_ISSUER=https://YOUR_TEAM.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=

# Alpha accounts. Cloudflare Access verifies the email; the origin then
# creates the account and grants this many page credits exactly once.
PAGESPATIAL_ALLOW_SELF_SIGNUP=1
PAGESPATIAL_TRIAL_PAGE_CREDITS=100

# Isolated PostgreSQL 18 container. Generate a long random password.
POSTGRES_DB=pagespatial
POSTGRES_USER=pagespatial
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://pagespatial:REPLACE_WITH_THE_SAME_PASSWORD@postgres:5432/pagespatial
PAGESPATIAL_DB_POOL_SIZE=10

# API-side R2 credentials. Buckets and access-key IDs must be distinct.
R2_INPUT_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_INPUT_BUCKET=pagespatial-inputs
R2_API_INPUT_ACCESS_KEY_ID=
R2_API_INPUT_SECRET_ACCESS_KEY=
R2_RESULTS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_RESULTS_BUCKET=pagespatial-results
R2_API_RESULTS_ACCESS_KEY_ID=
R2_API_RESULTS_SECRET_ACCESS_KEY=

# Existing qualified Modal application.
PAGESPATIAL_MODAL_APP_NAME=pagespatial-parse-internal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Placeholder estimate stamped onto each accepted job; integer USD micros/page.
PAGESPATIAL_UNIT_PRICE_MICROS=1000
